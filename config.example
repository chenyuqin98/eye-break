# eye-break config · copy to ~/.eye-break/config and edit
# 复制到 ~/.eye-break/config 后按需修改。只写你想改的行即可。

# Notification language · 通知语言:  auto | zh | en
# auto follows your macOS locale · auto 跟随系统语言
LANG_PREF=auto

# Only remind between these hours (24h) · 只在这个时段提醒
ACTIVE_START=9
ACTIVE_END=23

# Seconds of actual screen time per round · 攒够多少秒用眼时间提醒一次
INTERVAL=1200

# No keyboard/mouse for this long and the timer resets. This one is a guess,
# not a fact: idle time cannot tell "left the desk" from "reading the screen",
# so it has to stay well above a normal reading pause or it fires constantly.
# 这么久没碰键鼠就清零。注意这是推断而非事实：空闲时间分不清「离开工位」和
# 「正在读屏幕」，所以必须明显高于正常的阅读停顿，否则会不停误清零。
BREAK_RESET=120

# Tick gap this big means the machine slept. Keep well above the 60s tick
# interval — below it, every normal tick looks like a sleep and the timer
# never accumulates at all. Floored at 180 in code.
# tick 间隔这么大 = 机器睡过。必须明显大于 60 秒的 tick 间隔，否则每个正常
# tick 都会被误判成睡眠，永远攒不起来。代码里有 180 秒下限保护。
SLEEP_GAP=300

# Screen locked this long and the timer resets. Defaults to BREAK_SECONDS:
# locking the screen for 20 seconds already IS the 20-second break, and unlike
# idle time it is an explicit "I'm leaving" signal rather than a guess.
# 锁屏超过这么久就清零。默认等于 BREAK_SECONDS：锁屏 20 秒本身就已经是那
# 20 秒的远眺了。而且锁屏是明确的「我走了」信号，不像空闲时间那样靠猜。
LOCK_RESET=20

# Idle this long and the timer pauses (but does not reset)
# 空闲超过这么久就暂停累加，但不清零 —— 你可能只是在读屏幕
IDLE_PAUSE=90

# How long to look away · 远眺时长
BREAK_SECONDS=20

# Sounds · 音效 (any name from /System/Library/Sounds)
START_SOUND=Glass
END_SOUND=Ping

# Full-screen cover during the break · 休息期间的全屏遮罩
# 1 = cover the whole screen, 0 = notification only
# 遮罩会盖住整个屏幕，按 esc 可以跳过；它整段走完才算「照做」
OVERLAY=1

# 0.3 (barely dimmed) .. 1.0 (solid black) · 遮罩不透明度
OVERLAY_OPACITY=0.94

# Skip the cover while something is holding the display awake — screen shares,
# Keynote in play mode, video playback. Getting covered mid-presentation is
# the one failure mode worth avoiding.
# 有东西正撑着屏幕不休眠时不抢屏（投屏、演示、看视频）。演示到一半被遮罩
# 盖住是最难堪的翻车。注意：看视频时也会因此不遮罩。
OVERLAY_SKIP_WHEN_PRESENTING=1
